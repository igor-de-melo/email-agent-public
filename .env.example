# ─── email-agent — variáveis de ambiente ─────────────────────────────────────
# Copie este arquivo para ~/.env e preencha os valores reais.
# Depois execute: source ~/.env
# Para carregar automaticamente em toda sessão: echo "source ~/.env" >> ~/.bashrc

# Telegram 
export TELEGRAM_BOT_TOKEN=<coleaqui>
export TELEGRAM_CHAT_ID=<cole aqui>

# Anthropic
export ANTHROPIC_API_KEY=<cole aqui>

# Gmail
export GMAIL_PESSOAL_EMAIL=seu_email@gmail.com
export GMAIL_USP_EMAIL=seu_email@usp.br

# Hotmail (desabilitado — preencher quando Azure for resolvido)
# HOTMAIL_EMAIL=seu_email@hotmail.com
# AZURE_CLIENT_ID=<cole aqui>
